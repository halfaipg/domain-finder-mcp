# Everything here is optional. With no .env at all the server checks availability
# directly with the registries (RDAP + DNS) and needs no accounts or API keys.

# Exact registrar prices for finalists: adds the confirm-domain tool, which catches
# premium and reserved names. Keys are free at https://porkbun.com/account/api
# PORKBUN_API_KEY=pk1_...
# PORKBUN_SECRET_API_KEY=sk1_...

# Where availability checks go:
# rdap      (default) keyless registry lookups. Cannot see premium pricing.
# namecheap registrar API; adds premium detection and premium prices.
#           Needs an account with 20+ domains or $50+ balance/spend, and your IP whitelisted.
# domainr   legacy RapidAPI endpoint (deprecated upstream; kept for existing keys).
# If the chosen provider is missing its credentials the server falls back to rdap.
DOMAIN_PROVIDER=rdap

# NAMECHEAP_API_USER=your_username
# NAMECHEAP_API_KEY=your_api_key
# NAMECHEAP_CLIENT_IP=your_whitelisted_ip

# DOMAINR_RAPIDAPI_KEY=your_rapidapi_key
# DOMAINR_RAPIDAPI_HOST=domainr.p.rapidapi.com
