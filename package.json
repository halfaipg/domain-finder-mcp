{
  "name": "domain-finder-mcp",
  "version": "1.1.0",
  "description": "MCP server that finds available domain names: keyless availability checks via RDAP/DNS, typical prices, and every registrable TLD",
  "mcpName": "io.github.halfaipg/domain-finder-mcp",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "domain-finder-mcp": "dist/server.js"
  },
  "files": [
    "dist",
    "data",
    "tlds.txt",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "update-tlds": "node scripts/update-tlds.mjs",
    "setup": "./setup.sh"
  },
  "keywords": [
    "mcp",
    "domain",
    "domain-names",
    "rdap",
    "tld",
    "ai",
    "cursor",
    "claude-code",
    "namecheap"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/halfaipg/domain-finder-mcp.git"
  },
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "axios": "^1.6.7",
    "dotenv": "^17.2.1",
    "fast-xml-parser": "^4.3.4",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.1.0",
    "tsx": "^4.7.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
